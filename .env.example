# Copy to .env (which is gitignored) and fill in. The app runs WITHOUT any of
# these on the offline snapshot — they're only needed to refresh live data or
# enable LLM-written suggested actions.

# GitHub REST API — github.com/settings/tokens (classic, public_repo scope)
GITHUB_TOKEN=

# Reddit API via PRAW — reddit.com/prefs/apps (script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=engageiq by u/yourname

# Optional: Claude-written "Suggested Action" (falls back to free template if unset)
ANTHROPIC_API_KEY=

# Optional overrides
ENGAGEIQ_LOG_LEVEL=INFO
ENGAGEIQ_MODEL_VERSION=2025.06-tfidf-svd256
